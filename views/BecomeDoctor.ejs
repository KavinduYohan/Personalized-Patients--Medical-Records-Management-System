<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Doctor Registration Request - Medicare</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg medicare-navbar sticky-top">
    <div class="container">
      <a class="brand-title" href="/">
        <i class="bi bi-hospital fs-3 text-primary"></i> MEDICARE
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/"><i class="bi bi-house-door me-1"></i> Home</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/clinic"><i class="bi bi-building me-1"></i> Clinics</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/Alldoctors"><i class="bi bi-person-badge me-1"></i> Doctors</a></li>
          <% if (typeof currentUserId !== 'undefined' && currentUserId) { %>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/patientres"><i class="bi bi-calendar2-check me-1"></i> My Appointments</a></li>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
            <li class="nav-item ms-lg-2"><a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a></li>
          <% } else { %>
            <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm px-4" href="/login"><i class="bi bi-person-fill me-1"></i> Login</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
          <div class="card-header bg-primary-gradient text-white p-4">
            <h3 class="fw-bold mb-1"><i class="bi bi-heart-pulse-fill me-2"></i> Join as a Medical Practitioner</h3>
            <p class="text-white-50 small mb-0">Apply to become a verified consulting doctor on Medicare</p>
          </div>
          <div class="card-body p-4 p-md-5 bg-white">
            <form action="/BecomeDoctor" method="POST">
              <div class="mb-3">
                <label class="form-label" for="name">Doctor Full Name (with title)</label>
                <input type="text" class="form-control" id="name" name="name" placeholder="Dr. Jane Doe" required>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label" for="clinic">Assigned Clinic Center</label>
                  <select class="form-select" id="clinic" name="clinic" required>
                    <option value="A">Clinic A (General Hospital Colombo)</option>
                    <option value="B">Clinic B (Apex Health Kurunegala)</option>
                    <option value="C">Clinic C (Specialist Care)</option>
                    <option value="D">Clinic D (Wellness Hub)</option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="specialization">Medical Specialization</label>
                  <input type="text" class="form-control" id="specialization" name="specialization" placeholder="e.g. Cardiologist, Dermatologist" required>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label" for="slmcNumber">SLMC / Medical Council Number</label>
                  <input type="text" class="form-control" id="slmcNumber" name="slmcNumber" placeholder="SLMC-12345" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="image">Profile Photo URL (Optional)</label>
                  <input type="text" class="form-control" id="image" name="image" placeholder="https://images.unsplash.com/...">
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label" for="about">Professional Bio & Experience</label>
                <textarea class="form-control" id="about" name="about" rows="4" placeholder="Describe your clinical qualifications, awards, and consultation experience..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary w-100 py-3 fw-bold">
                <i class="bi bi-send-check me-2"></i> Submit Doctor Profile
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="bg-white border-top py-4 text-center text-muted small mt-5">
    <div class="container">
      &copy; <%= new Date().getFullYear() %> MEDICARE Centralized Healthcare Booking System.
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
