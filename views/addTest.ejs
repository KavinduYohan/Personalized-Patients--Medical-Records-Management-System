<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Laboratory Diagnostic Test - Medicare Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
  <style>
    .admin-sidebar {
      width: 260px;
      min-height: 100vh;
      background: #0f172a;
      color: #fff;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      padding: 24px 16px;
    }
    .admin-main {
      margin-left: 260px;
      padding: 30px;
      background-color: #f8fafc;
      min-height: 100vh;
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: #94a3b8;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 6px;
      transition: all 0.2s;
    }
    .sidebar-link:hover, .sidebar-link.active {
      color: #ffffff;
      background-color: #1e293b;
    }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <aside class="admin-sidebar d-flex flex-column">
      <div class="px-2 mb-4">
        <a class="brand-title text-white" href="/adminPanel">
          <i class="bi bi-shield-check fs-4 text-info"></i> MEDICARE
        </a>
        <div class="badge bg-danger mt-1">Admin Panel</div>
      </div>

      <nav class="flex-grow-1">
        <a href="/adminPanel" class="sidebar-link"><i class="bi bi-people-fill"></i> User Directory</a>
        <a href="/adminPanel#doctorRequestsSection" class="sidebar-link"><i class="bi bi-person-check-fill"></i> Doctor Requests</a>
        <a href="/addTest" class="sidebar-link active"><i class="bi bi-file-earmark-medical"></i> Add Lab Test</a>
        <a href="/addtesttable" class="sidebar-link"><i class="bi bi-folder-check"></i> Manage Lab Tests</a>
      </nav>

      <div class="border-top border-secondary pt-3">
        <a href="/logout" class="sidebar-link text-danger"><i class="bi bi-box-arrow-right"></i> Logout Admin</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-main flex-grow-1">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
          <h2 class="fw-bold mb-1">Add Laboratory Test</h2>
          <p class="text-muted mb-0">Register available diagnostic packages and pathology lab tests</p>
        </div>
        <a href="/addtesttable" class="btn btn-outline-primary btn-sm"><i class="bi bi-folder-check me-1"></i> View Existing Tests</a>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <form action="/addTest" method="POST">
              <div class="mb-4">
                <label class="form-label fw-bold" for="pname">Laboratory Test Name</label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="bi bi-clipboard2-pulse text-primary"></i></span>
                  <input type="text" class="form-control" id="pname" name="pname" placeholder="e.g. Complete Blood Count (CBC) / Lipid Profile" required>
                </div>
                <div class="form-text">Specify the standardized clinical test name.</div>
              </div>

              <div class="d-flex gap-2">
                <a href="/adminPanel" class="btn btn-outline-secondary flex-grow-1">Cancel</a>
                <button type="submit" class="btn btn-primary flex-grow-1 py-2 fw-bold">
                  <i class="bi bi-plus-circle me-1"></i> Register Diagnostic Test
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
