<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Laboratory Test Catalog - Medicare Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
  <style>
    .admin-sidebar {
      width: 260px;
      min-height: 100vh;
      background: #0f172a;
      color: #fff;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
      padding: 24px 16px;
    }
    .admin-main {
      margin-left: 260px;
      padding: 30px;
      background-color: #f8fafc;
      min-height: 100vh;
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: #94a3b8;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 6px;
      transition: all 0.2s;
    }
    .sidebar-link:hover, .sidebar-link.active {
      color: #ffffff;
      background-color: #1e293b;
    }
  </style>
</head>
<body>
  <%- include('common/toasts') %>
  <%- include('common/confirmModal') %>
  <div class="d-flex">
    <!-- Sidebar -->
    <aside class="admin-sidebar d-flex flex-column">
      <div class="px-2 mb-4">
        <a class="brand-title text-white" href="/adminPanel">
          <i class="bi bi-shield-check fs-4 text-info"></i> MEDICARE
        </a>
        <div class="badge bg-danger mt-1">Admin Panel</div>
      </div>

      <nav class="flex-grow-1">
        <a href="/adminPanel" class="sidebar-link"><i class="bi bi-people-fill"></i> User Directory</a>
        <a href="/adminPanel#doctorRequestsSection" class="sidebar-link"><i class="bi bi-person-check-fill"></i> Doctor Requests</a>
        <a href="/addTest" class="sidebar-link"><i class="bi bi-file-earmark-medical"></i> Add Lab Test</a>
        <a href="/addtesttable" class="sidebar-link active"><i class="bi bi-folder-check"></i> Manage Lab Tests</a>
      </nav>

      <div class="border-top border-secondary pt-3">
        <a href="/logout" class="sidebar-link text-danger"><i class="bi bi-box-arrow-right"></i> Logout Admin</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-main flex-grow-1">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
          <h2 class="fw-bold mb-1">Laboratory Diagnostics Directory</h2>
          <p class="text-muted mb-0">List of clinical investigation tests available for patient channeling and reports</p>
        </div>
        <a href="/addTest" class="btn btn-primary btn-sm px-3"><i class="bi bi-plus-lg me-1"></i> Add New Test</a>
      </div>

      <% if (typeof sucess !== 'undefined' && sucess && sucess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show">
          <i class="bi bi-check-circle me-2"></i> <%= sucess %>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show">
          <i class="bi bi-exclamation-circle me-2"></i> <%= error %>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-card-checklist me-2 text-primary"></i> Registered Lab Tests</h5>
          <span class="badge bg-secondary"><%= typeof empData !== 'undefined' ? empData.length : 0 %> Total Records</span>
        </div>
        <div class="table-responsive">
          <table class="table medicare-table table-hover mb-0">
            <thead>
              <tr>
                <th>Test Reference ID</th>
                <th>Diagnostic Test Name</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof empData !== 'undefined' && empData.length > 0) { %>
                <% empData.forEach(test => { %>
                  <tr>
                    <td class="text-muted small"><%= test._id.toString() %></td>
                    <td class="fw-bold text-dark">
                      <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary-light text-primary rounded-circle p-2">
                          <i class="bi bi-clipboard-pulse"></i>
                        </div>
                        <%= test.testname %>
                      </div>
                    </td>
                    <td class="text-end">
                      <form action="/deletetest/<%= test._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger px-3"
                                data-confirm="Are you sure you want to remove '<%= test.testname %>' from available lab tests?"
                                data-confirm-title="Delete Diagnostic Test"
                                data-confirm-type="delete"
                                data-confirm-btn="Delete Test">
                          <i class="bi bi-trash me-1"></i> Delete
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="text-center py-5 text-muted">
                    <i class="bi bi-clipboard2-x fs-1 d-block mb-2 text-primary"></i>
                    <h5>No Laboratory Tests Configured</h5>
                    <p class="text-muted">Register diagnostic tests using the Add Lab Test button.</p>
                    <a href="/addTest" class="btn btn-primary btn-sm mt-2">Add First Lab Test</a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
