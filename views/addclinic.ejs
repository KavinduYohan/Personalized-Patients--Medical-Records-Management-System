<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register New Medical Clinic - Medicare</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg medicare-navbar sticky-top">
    <div class="container">
      <a class="brand-title" href="/">
        <i class="bi bi-hospital fs-3 text-primary"></i> MEDICARE
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/"><i class="bi bi-house-door me-1"></i> Home</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/clinic"><i class="bi bi-building me-1"></i> Clinics</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/Alldoctors"><i class="bi bi-person-badge me-1"></i> Doctors</a></li>
          <% if (typeof currentUserId !== 'undefined' && currentUserId) { %>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/patientres"><i class="bi bi-calendar2-check me-1"></i> My Appointments</a></li>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
            <li class="nav-item ms-lg-2"><a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a></li>
          <% } else { %>
            <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm px-4" href="/login"><i class="bi bi-person-fill me-1"></i> Login</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
          <div class="card-header bg-primary-gradient text-white p-4">
            <h3 class="fw-bold mb-1"><i class="bi bi-hospital-fill me-2"></i> Register New Health Clinic</h3>
            <p class="text-white-50 small mb-0">Add a new clinic facility and register its resident consulting doctors</p>
          </div>
          <div class="card-body p-4 p-md-5 bg-white">
            <form action="/addclinic" method="POST">
              <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-info-circle me-2 text-primary"></i> Clinic Details</h5>
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <label class="form-label" for="clinicName">Clinic Name</label>
                  <input type="text" class="form-control" id="clinicName" name="clinicName" placeholder="e.g. Central Care Medical Center" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="location">Location / City</label>
                  <input type="text" class="form-control" id="location" name="location" placeholder="e.g. Colombo 07, Sri Lanka" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="licenceNumber">Operating Licence Number</label>
                  <input type="text" class="form-control" id="licenceNumber" name="licenceNumber" placeholder="e.g. MED-LIC-2024-880" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="services">Medical Services Offered</label>
                  <input type="text" class="form-control" id="services" name="services" placeholder="e.g. Cardiology, Lab, X-Ray, OPD" required>
                </div>

                <div class="col-12">
                  <label class="form-label" for="description">Short Facility Description</label>
                  <textarea class="form-control" id="description" name="description" rows="2" placeholder="Brief description of facilities and available clinical care..." required></textarea>
                </div>
              </div>

              <hr class="my-4">

              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-secondary"><i class="bi bi-person-badge-fill me-2 text-primary"></i> Initial Doctors</h5>
                <button type="button" class="btn btn-outline-primary btn-sm" id="addDoctor">
                  <i class="bi bi-plus-lg me-1"></i> Add Another Doctor
                </button>
              </div>

              <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle" id="doctorsTable">
                  <thead class="table-light">
                    <tr>
                      <th>Doctor Name</th>
                      <th>Clinic Code</th>
                      <th>Specialization</th>
                      <th>SLMC No</th>
                      <th>Email</th>
                      <th>About / Bio</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><input type="text" class="form-control form-control-sm" name="doctorDetails[0][name]" placeholder="Dr. Name" required></td>
                      <td>
                        <select class="form-select form-select-sm" name="doctorDetails[0][clinic]" required>
                          <option value="A">A</option>
                          <option value="B">B</option>
                          <option value="C">C</option>
                        </select>
                      </td>
                      <td><input type="text" class="form-control form-control-sm" name="doctorDetails[0][specialization]" placeholder="Cardiology" required></td>
                      <td><input type="text" class="form-control form-control-sm" name="doctorDetails[0][slmcNumber]" placeholder="SLMC-001" required></td>
                      <td><input type="email" class="form-control form-control-sm" name="doctorDetails[0][email]" placeholder="doctor@clinic.com" required></td>
                      <td><input type="text" class="form-control form-control-sm" name="doctorDetails[0][about]" placeholder="Consultant bio" required></td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <button type="submit" class="btn btn-primary w-100 py-3 fw-bold">
                <i class="bi bi-check2-circle me-2"></i> Register Clinic and Onboard Doctors
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="bg-white border-top py-4 text-center text-muted small mt-5">
    <div class="container">
      &copy; <%= new Date().getFullYear() %> MEDICARE Centralized Healthcare Booking System.
    </div>
  </footer>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    $(document).ready(function(){
      let doctorIndex = 1;
      $("#addDoctor").click(function(){
        let doctorRow = `
          <tr>
            <td><input type="text" class="form-control form-control-sm" name="doctorDetails[${doctorIndex}][name]" placeholder="Dr. Name" required></td>
            <td>
              <select class="form-select form-select-sm" name="doctorDetails[${doctorIndex}][clinic]" required>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
              </select>
            </td>
            <td><input type="text" class="form-control form-control-sm" name="doctorDetails[${doctorIndex}][specialization]" placeholder="Specialty" required></td>
            <td><input type="text" class="form-control form-control-sm" name="doctorDetails[${doctorIndex}][slmcNumber]" placeholder="SLMC" required></td>
            <td><input type="email" class="form-control form-control-sm" name="doctorDetails[${doctorIndex}][email]" placeholder="Email" required></td>
            <td><input type="text" class="form-control form-control-sm" name="doctorDetails[${doctorIndex}][about]" placeholder="Bio" required></td>
          </tr>`;
        $("#doctorsTable tbody").append(doctorRow);
        doctorIndex++;
      });
    });
  </script>
</body>
</html>
