<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Medical Clinics Network - Medicare</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Header / Navigation -->
  <nav class="navbar navbar-expand-lg medicare-navbar sticky-top">
    <div class="container">
      <a class="brand-title" href="/">
        <i class="bi bi-hospital fs-3 text-primary"></i> MEDICARE
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/"><i class="bi bi-house-door me-1"></i> Home</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom active text-primary" href="/clinic"><i class="bi bi-building me-1"></i> Clinics</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/Alldoctors"><i class="bi bi-person-badge me-1"></i> Doctors</a></li>
          <% if (typeof currentUserId !== 'undefined' && currentUserId) { %>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/patientres"><i class="bi bi-calendar2-check me-1"></i> My Appointments</a></li>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
            <li class="nav-item ms-lg-2"><a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a></li>
          <% } else { %>
            <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm px-4" href="/login"><i class="bi bi-person-fill me-1"></i> Login</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border-bottom py-5">
    <div class="container text-center">
      <h1 class="fw-bold mb-2">Our Healthcare Clinics</h1>
      <p class="text-muted mx-auto" style="max-width: 650px;">
        Browse our accredited partner medical centers, outpatient care facilities, and specialized diagnostic clinics.
      </p>
    </div>
  </div>

  <!-- Clinics Grid -->
  <div class="container py-5">
    <% if (clinics && clinics.length > 0) { %>
      <div class="row g-4">
        <% clinics.forEach((clinic, idx) => { %>
          <div class="col-md-6 col-lg-4">
            <div class="medicare-card h-100 p-4 d-flex flex-column">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-3">
                  <div class="bg-primary-light text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-hospital fs-4"></i>
                  </div>
                  <div>
                    <h5 class="fw-bold mb-0 text-dark"><%= clinic.clinicName %></h5>
                    <span class="text-muted small"><i class="bi bi-geo-alt-fill text-danger me-1"></i> <%= clinic.location %></span>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <span class="badge bg-light text-secondary border"><i class="bi bi-award me-1"></i> Lic: <%= clinic.licenceNumber %></span>
              </div>

              <p class="text-muted small flex-grow-1"><%= clinic.description %></p>

              <div class="p-3 bg-light rounded-3 mb-3">
                <div class="fw-bold small text-secondary mb-1"><i class="bi bi-shield-plus text-primary me-1"></i> Available Services:</div>
                <div class="small text-muted"><%= clinic.services %></div>
              </div>

              <div class="d-flex gap-2 mt-auto">
                <a href="/Alldoctors" class="btn btn-primary btn-sm flex-grow-1 py-2"><i class="bi bi-calendar-plus me-1"></i> Book Doctor</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-5">
        <div class="text-muted fs-1 mb-3"><i class="bi bi-building-slash"></i></div>
        <h4>No Clinics Found</h4>
        <p class="text-muted">No clinics are currently registered in the system.</p>
        <a href="/addclinic" class="btn btn-primary btn-sm mt-2">Register a Clinic</a>
      </div>
    <% } %>
  </div>

  <footer class="bg-white border-top py-4 text-center text-muted small mt-5">
    <div class="container">
      &copy; <%= new Date().getFullYear() %> MEDICARE Centralized Healthcare Booking System. All rights reserved.
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
