<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>Medicare - Centralized Healthcare & Channeling System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
  <style>
    .hero-banner {
      background: radial-gradient(circle at top right, rgba(2, 132, 199, 0.15), transparent 40%),
                  radial-gradient(circle at bottom left, rgba(13, 148, 136, 0.1), transparent 40%),
                  #ffffff;
      padding: 90px 0 80px;
      border-bottom: 1px solid var(--border-color);
    }
    .feature-icon-box {
      width: 60px;
      height: 60px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      margin-bottom: 18px;
    }
  </style>
</head>
<body>
  <%- include('common/toasts') %>
  <!-- Header Nav -->
  <nav class="navbar navbar-expand-lg medicare-navbar sticky-top">
    <div class="container">
      <a class="brand-title" href="/">
        <i class="bi bi-hospital fs-3 text-primary"></i> MEDICARE
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item"><a class="nav-link nav-link-custom active text-primary" href="/"><i class="bi bi-house-door me-1"></i> Home</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/clinic"><i class="bi bi-building me-1"></i> Clinics</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/Alldoctors"><i class="bi bi-person-badge me-1"></i> Find Doctors</a></li>

          <% if (typeof currentUserId !== 'undefined' && currentUserId) { %>
            <% if (typeof userRole !== 'undefined' && userRole === 'doctor') { %>
              <li class="nav-item"><a class="nav-link nav-link-custom fw-bold text-info" href="/doctor"><i class="bi bi-speedometer2 me-1"></i> Doctor Dashboard</a></li>
            <% } %>
            <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
              <li class="nav-item"><a class="nav-link nav-link-custom fw-bold text-danger" href="/adminPanel"><i class="bi bi-shield-lock me-1"></i> Admin Panel</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/patientres"><i class="bi bi-calendar2-check me-1"></i> My Appointments</a></li>
            <li class="nav-item"><a class="nav-link nav-link-custom" href="/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
            <li class="nav-item ms-lg-2"><a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a></li>
          <% } else { %>
            <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm px-4" href="/login"><i class="bi bi-person-fill me-1"></i> Login</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero-banner">
    <div class="container">
      <% if (typeof sucess !== 'undefined' && sucess && sucess.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4">
          <i class="bi bi-check-circle me-2"></i> <%= sucess %>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-4">
          <i class="bi bi-exclamation-circle me-2"></i> <%= error %>
        </div>
      <% } %>

      <div class="row align-items-center gy-5">
        <div class="col-lg-7">
          <div class="badge bg-primary-light text-primary px-3 py-2 rounded-pill fw-bold mb-3">
            <i class="bi bi-check2-circle me-1"></i> Centralized Healthcare & Channeling
          </div>
          <h1 class="display-4 fw-extrabold text-dark mb-3" style="letter-spacing: -1px; font-weight: 800;">
            Next-Generation Medical Care & Doctor Channeling
          </h1>
          <p class="lead text-muted mb-4" style="font-size: 1.15rem;">
            Seamlessly connect with top certified medical practitioners, browse partner clinics across Sri Lanka, and manage your health records in one secure platform.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href="/Alldoctors" class="btn btn-primary px-4 py-3 fw-bold shadow-sm">
              <i class="bi bi-calendar-plus me-2"></i> Book Doctor Appointment
            </a>
            <a href="/clinic" class="btn btn-outline-secondary px-4 py-3 fw-bold">
              <i class="bi bi-building me-2"></i> Explore Clinics
            </a>
          </div>
        </div>
        <div class="col-lg-5 text-center">
          <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=800&auto=format&fit=crop&q=80"
               class="img-fluid rounded-4 shadow-lg" alt="Healthcare Doctor">
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Action Features -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-4">
          <div class="p-4 rounded-4 bg-light h-100 border transition hover-shadow">
            <div class="feature-icon-box bg-primary-light text-primary">
              <i class="bi bi-person-badge-fill"></i>
            </div>
            <h5 class="fw-bold mb-2">Verified Consultants</h5>
            <p class="text-muted small mb-0">Book appointments with registered SLMC doctors across cardiology, neurology, pediatrics, and more.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-4 rounded-4 bg-light h-100 border transition hover-shadow">
            <div class="feature-icon-box bg-success bg-opacity-10 text-success">
              <i class="bi bi-calendar-check-fill"></i>
            </div>
            <h5 class="fw-bold mb-2">Instant Scheduling</h5>
            <p class="text-muted small mb-0">Choose morning, afternoon, or evening slots with real-time status tracking for patients and doctors.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="p-4 rounded-4 bg-light h-100 border transition hover-shadow">
            <div class="feature-icon-box bg-info bg-opacity-10 text-info">
              <i class="bi bi-shield-check"></i>
            </div>
            <h5 class="fw-bold mb-2">Electronic Health Profile</h5>
            <p class="text-muted small mb-0">Maintain your emergency contact, blood group, and medical profile accessible whenever you need care.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Clinics Section -->
  <section class="py-5" style="background-color: #f8fafc;">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="fw-bold mb-1">Our Partner Health Clinics</h2>
          <p class="text-muted mb-0">Visit specialized clinics and outpatient diagnostic centers</p>
        </div>
        <a href="/clinic" class="btn btn-outline-primary btn-sm px-3 fw-bold">View All Clinics <i class="bi bi-arrow-right ms-1"></i></a>
      </div>

      <% if (typeof clinics !== 'undefined' && clinics.length > 0) { %>
        <div class="row g-4">
          <% clinics.slice(0, 3).forEach(clinic => { %>
            <div class="col-md-4">
              <div class="medicare-card h-100 p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                  <div class="p-3 bg-primary-light text-primary rounded-3">
                    <i class="bi bi-hospital fs-4"></i>
                  </div>
                  <div>
                    <h5 class="fw-bold mb-0 text-dark"><%= clinic.clinicName %></h5>
                    <span class="text-muted small"><i class="bi bi-geo-alt-fill text-danger me-1"></i> <%= clinic.location %></span>
                  </div>
                </div>
                <p class="text-muted small flex-grow-1"><%= clinic.description %></p>
                <div class="p-2 bg-light rounded-3 small text-secondary mb-3">
                  <strong>Services:</strong> <%= clinic.services %>
                </div>
                <a href="/Alldoctors" class="btn btn-outline-primary btn-sm w-100 py-2"><i class="bi bi-calendar-plus me-1"></i> View & Book Doctors</a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-4 text-muted">
          <p>No clinics currently available.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Onboarding Request Sections -->
  <section class="py-5 bg-white border-top border-bottom">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="p-4 p-md-5 rounded-4 bg-primary text-white h-100 position-relative overflow-hidden" style="background: var(--primary-gradient);">
            <h3 class="fw-bold mb-2">Are You a Qualified Doctor?</h3>
            <p class="text-white-50 mb-4">Register your practice on Medicare to manage patient queues, consult patients, and handle appointments smoothly.</p>
            <a href="/BecomeDoctor" class="btn btn-light text-primary fw-bold px-4 py-2"><i class="bi bi-heart-pulse-fill me-1"></i> Apply as a Doctor</a>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-4 p-md-5 rounded-4 bg-dark text-white h-100 position-relative overflow-hidden">
            <h3 class="fw-bold mb-2">Register a Healthcare Clinic</h3>
            <p class="text-white-50 mb-4">Expand your clinic's patient outreach and allow users across the country to book appointments online.</p>
            <a href="/addclinic" class="btn btn-outline-light fw-bold px-4 py-2"><i class="bi bi-building-add me-1"></i> Register New Clinic</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-dark text-white py-5">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4">
          <h4 class="fw-bold text-white mb-3"><i class="bi bi-hospital text-info me-2"></i> MEDICARE</h4>
          <p class="text-white-50 small">
            Centralized Patient Record & Doctor Channeling System designed to streamline healthcare access, consultation scheduling, and medical records management.
          </p>
        </div>
        <div class="col-lg-4">
          <h6 class="text-uppercase fw-bold text-white-50 mb-3">Quick Links</h6>
          <ul class="list-unstyled small">
            <li class="mb-2"><a href="/" class="text-white-50 text-decoration-none">Home</a></li>
            <li class="mb-2"><a href="/clinic" class="text-white-50 text-decoration-none">Clinics</a></li>
            <li class="mb-2"><a href="/Alldoctors" class="text-white-50 text-decoration-none">Find Doctors</a></li>
            <li class="mb-2"><a href="/login" class="text-white-50 text-decoration-none">Account Login</a></li>
          </ul>
        </div>
        <div class="col-lg-4">
          <h6 class="text-uppercase fw-bold text-white-50 mb-3">Contact Support</h6>
          <p class="text-white-50 small mb-1"><i class="bi bi-envelope me-2"></i> support@medicare.lk</p>
          <p class="text-white-50 small mb-1"><i class="bi bi-telephone me-2"></i> +94 (11) 234-5678</p>
          <p class="text-white-50 small"><i class="bi bi-geo-alt me-2"></i> Wayamba University, Kuliyapitiya</p>
        </div>
      </div>
      <hr class="border-secondary my-4">
      <div class="text-center text-white-50 small">
        &copy; <%= new Date().getFullYear() %> MEDICARE. Rapid Application Development Project.
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>