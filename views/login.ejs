<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Medicare Centralized System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-logo">
          <i class="bi bi-hospital"></i>
        </div>
        <h2 class="auth-title">Welcome Back</h2>
        <p class="auth-subtitle">Login to access your Medicare dashboard</p>
      </div>

      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="alert-message alert-error">
          <i class="bi bi-exclamation-circle-fill me-2"></i> <%= error %>
        </div>
      <% } %>

      <% if (typeof sucess !== 'undefined' && sucess && sucess.length > 0) { %>
        <div class="alert-message alert-success">
          <i class="bi bi-check-circle-fill me-2"></i> <%= sucess %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group mb-3">
          <label class="form-label" for="email">Email Address</label>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
            <input type="email" class="form-control" id="email" name="email" placeholder="name@medicare.com" required autocomplete="email">
          </div>
        </div>

        <div class="form-group mb-4">
          <label class="form-label" for="password">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
            <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
          </div>
        </div>

        <button type="submit" class="btn-primary-gradient mb-3">
          <i class="bi bi-box-arrow-in-right me-2"></i> Login to Account
        </button>
      </form>

      <div class="text-center mt-3">
        <p class="text-muted small mb-0">Don't have an account yet? <a href="/register" class="fw-bold text-primary text-decoration-none">Sign Up Here</a></p>
      </div>

      <div class="mt-4 pt-3 border-top text-center">
        <a href="/" class="small text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Homepage</a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>