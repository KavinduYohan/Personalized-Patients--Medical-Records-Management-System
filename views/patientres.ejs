<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Reservations - Medicare</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg medicare-navbar sticky-top">
    <div class="container">
      <a class="brand-title" href="/">
        <i class="bi bi-hospital fs-3 text-primary"></i> MEDICARE
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/"><i class="bi bi-house-door me-1"></i> Home</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/clinic"><i class="bi bi-building me-1"></i> Clinics</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/Alldoctors"><i class="bi bi-person-badge me-1"></i> Doctors</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom active text-primary" href="/patientres"><i class="bi bi-calendar2-check me-1"></i> My Appointments</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
          <li class="nav-item ms-lg-2"><a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1">My Medical Appointments</h2>
        <p class="text-muted mb-0">Track status and schedule details for your doctor consultations</p>
      </div>
      <a href="/Alldoctors" class="btn btn-primary btn-sm px-3"><i class="bi bi-plus-lg me-1"></i> Book New Doctor</a>
    </div>

    <% if (typeof sucess !== 'undefined' && sucess && sucess.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4">
        <i class="bi bi-check-circle me-2"></i> <%= sucess %>
      </div>
    <% } %>

    <% if (typeof err !== 'undefined' && err && err.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4">
        <i class="bi bi-exclamation-circle me-2"></i> <%= err %>
      </div>
    <% } %>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
      <div class="table-responsive">
        <table class="table medicare-table table-hover mb-0">
          <thead>
            <tr>
              <th>Doctor</th>
              <th>Appointment Date</th>
              <th>Time Slot</th>
              <th>Appointment Status</th>
              <th>Your Message / Reason</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof reservations !== 'undefined' && reservations.length > 0) { %>
              <% reservations.forEach(resv => { %>
                <tr>
                  <td>
                    <div class="fw-bold text-dark">
                      <%= resv.doctorId ? (resv.doctorId.name || 'Specialist Doctor') : 'Assigned Doctor' %>
                    </div>
                  </td>
                  <td class="fw-bold text-dark"><%= new Date(resv.date).toLocaleDateString() %></td>
                  <td>
                    <span class="badge bg-light text-secondary border text-capitalize"><%= resv.timeSlot %></span>
                  </td>
                  <td>
                    <% if (resv.status === 'accepted') { %>
                      <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Accepted</span>
                    <% } else if (resv.status === 'rejected') { %>
                      <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                    <% } else { %>
                      <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Pending Approval</span>
                    <% } %>
                  </td>
                  <td class="text-muted small"><%= resv.message || 'No additional note provided' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-5 text-muted">
                  <i class="bi bi-calendar-check fs-1 d-block mb-2 text-primary"></i>
                  <h5>No Appointments Booked Yet</h5>
                  <p class="text-muted">You haven't made any doctor reservations yet.</p>
                  <a href="/Alldoctors" class="btn btn-primary btn-sm mt-2">Find a Doctor & Book Now</a>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
