<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Doctor Appointments - Medicare</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Header / Navigation -->
  <nav class="navbar navbar-expand-lg medicare-navbar sticky-top">
    <div class="container">
      <a class="brand-title" href="/doctor">
        <i class="bi bi-hospital fs-3 text-primary"></i> MEDICARE
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/doctor"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom active text-primary" href="/status"><i class="bi bi-calendar2-check me-1"></i> Appointments</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/clinic"><i class="bi bi-building me-1"></i> Clinics</a></li>
          <li class="nav-item"><a class="nav-link nav-link-custom" href="/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
          <li class="nav-item ms-lg-2"><a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1">Doctor Appointment Requests</h2>
        <p class="text-muted mb-0">Review, accept, or reject incoming patient consultation bookings</p>
      </div>
      <a href="/doctor" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
      <div class="table-responsive">
        <table class="table medicare-table table-hover mb-0">
          <thead>
            <tr>
              <th>Patient</th>
              <th>Date</th>
              <th>Time Slot</th>
              <th>Reason / Message</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof reservations !== 'undefined' && reservations.length > 0) { %>
              <% reservations.forEach(resv => { %>
                <tr>
                  <td>
                    <div class="fw-bold text-dark"><%= resv.patientId ? resv.patientId.name : 'Registered Patient' %></div>
                    <div class="small text-muted"><%= resv.patientId ? resv.patientId.email : 'N/A' %></div>
                  </td>
                  <td class="fw-bold"><%= new Date(resv.date).toLocaleDateString() %></td>
                  <td>
                    <span class="badge bg-light text-secondary border text-capitalize"><%= resv.timeSlot %></span>
                  </td>
                  <td class="text-muted small"><%= resv.message || 'No message attached' %></td>
                  <td>
                    <% if (resv.status === 'accepted') { %>
                      <span class="badge bg-success">Accepted</span>
                    <% } else if (resv.status === 'rejected') { %>
                      <span class="badge bg-danger">Rejected</span>
                    <% } else { %>
                      <span class="badge bg-warning text-dark">Pending</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-2">
                      <form action="/status/<%= resv._id %>/accept" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success px-3" <%= resv.status === 'accepted' ? 'disabled' : '' %>>
                          <i class="bi bi-check-lg me-1"></i> Accept
                        </button>
                      </form>
                      <form action="/status/<%= resv._id %>/reject" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger px-2" <%= resv.status === 'rejected' ? 'disabled' : '' %>>
                          <i class="bi bi-x-lg"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                  <h5>No Appointment Requests</h5>
                  <p>There are no appointments reserved under your doctor profile.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
